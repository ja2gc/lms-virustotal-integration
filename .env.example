# Copy this file to .env on your own computer. Never put a real key in this example.
# Obtain your personal key at https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# Offline fixtures never contact VirusTotal. Live mode uses your own key.
SCAN_MODE=fixture

# Optional: external private directory; quote paths containing spaces.
# SCAN_PRIVATE_DIR="C:/private-lms/submissions"

# Optional limits: upload 1..10485760 bytes; provider 2..4/minute and 2..500/day.
SCAN_MAX_UPLOAD_BYTES=10485760
SCAN_REQUESTS_PER_MINUTE=4
SCAN_REQUESTS_PER_DAY=500
